{
  "name": "@todd/webserver-base",
  "version": "0.1.2",
  "exports": {
    ".": "./webserver-base/mod.ts",
    "./bundle": "./webserver-base/bundle.ts",
    "./free-port": "./webserver-base/free-port.ts",
    "./logger": "./webserver-base/logger.ts"
  },
  "publish": {
    "include": [
      "webserver-base/**/*.ts",
      "deno.*",
      "LICENSE",
      "README.md"
    ]
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns"
    ]
  },
  "fmt": {
    "lineWidth": 120
  },
  "imports": {
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@0.11.1",
    "@std/assert": "jsr:@std/assert@1.0.17",
    "esbuild": "npm:esbuild@0.24.2"
  }
}
