<!DOCTYPE html>
<html lang="{{language_code}}-{{country_code}}">

<head>
  {{! Robots }}
  <meta name="robots" content="{{robots}}">

  {{! Favicon }}
  <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">

  {{! Standard }}
  <meta charset="{{charset}}">
  <title>{{display_name}}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
  <meta name="description" content="{{description}}">
  <meta name="summary" content="{{description}}">
  <meta name="keywords" content="{{join keywords}}">
  <meta name="author" content="{{author}}">
  <meta name="application-name" content="{{project}}">
  <meta name="copyright" content="{{author}}">
  <meta name="subject" content="{{project}}">
  <meta name="topic" content="{{project}}">
  <meta name="designer" content="{{author}}">
  <meta name="owner" content="{{author}}">

  {{! OpenGraph }}
  {{! https://ogp.me/ }}
  <meta property="og:title" content="{{display_name}}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{canonical_url}}">
  <meta property="og:image" content="{{social_image}}">
  <meta property="og:image:alt" content="{{social_image_alt}}">
  <meta property="og:description" content="{{description}}">
  <meta property="og:locale" content="{{locale}}">
  <meta property="og:site_name" content="{{project}}">
  {{#each see_also}}
  <meta property="og:see_also" content="{{this}}">
  {{/each}}

  {{! Twitter }}
  {{! https://developer.twitter.com/en/docs/tweets/optimize-with-cards/overview/abouts-cards }}
  <meta name="twitter:card" content="summary">
  <meta name="twitter:creator" content="@{{twitter_username}}">
  <meta name="twitter:site" content="@{{twitter_username}}">
  <meta name="twitter:title" content="{{display_name}}">
  <meta name="twitter:description" content="{{description}}">
  <meta name="twitter:url" content="{{canonical_url}}">
  <meta name="twitter:image" content="{{social_image}}">
  <meta name="twitter:image:alt" content="{{social_image_alt}}">

  {{! Android }}
  <meta name="theme-color" content="{{theme_color}}">

  {{! Microformats }}
  <link href="{{canonical_url}}" rel="canonical">
  <link href="{{base_url}}" rel="home">
  <link type="text/plain" rel="author" href="{{base_url}}/humans.txt">

  {{! Schema.org, escaped by the framework so it cannot break out of this block }}
  {{#if jsonld}}
  <script type="application/ld+json">{{{jsonld}}}</script>
  {{/if}}

  {{! Style Sheets }}
  {{#each style_sheets}}
  {{#if (has_key ../cache_buster this)}}
  <link rel="stylesheet" type="text/css" href="/{{lookup ../cache_buster this}}">
  {{else}}
  <link rel="stylesheet" type="text/css" href="{{this}}">
  {{/if}}
  {{/each}}
</head>

<body class="color-background">
  {{> main}}
  {{> footer}}

  {{! Scripts }}
  {{#each scripts}}
  {{#if (has_key ../cache_buster this)}}
  <script type="module" src="/{{lookup ../cache_buster this}}"></script>
  {{else}}
  <script type="module" src="{{this}}"></script>
  {{/if}}
  {{/each}}
</body>

</html>
